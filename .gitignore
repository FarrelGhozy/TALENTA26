.env
.env.local
.env.*.local
!.env.example

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Coverage & test ──
coverage/
.nyc_output/

# ── Cache ──
.vite/
.cache/
*.cache
.eslintcache
.oxlintcache

# ── OS ──
