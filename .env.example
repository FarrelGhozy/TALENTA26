# Frontend demo lokal
VITE_APP_ENV=DEPLOYMENT
VITE_API_BASE_URL=/api/v1

# Aplikasi produksi — isi di .env root server saat backend tersedia
PUBLIC_ORIGIN=https://talenta.example.com
DATABASE_URL=mysql://talenta_app:change-me@mysql.internal:3306/talenta
SESSION_SECRET=change-with-a-long-random-secret
COOKIE_SECRET=change-with-another-long-random-secret

# RustFS / S3 compatible — gunakan service account khusus aplikasi
S3_ENDPOINT=http://rustfs.internal:9000
S3_REGION=us-east-1
S3_BUCKET=talenta-private
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Bootstrap satu kali pada Stage 2; jangan isi password tetap di repo
SUPER_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
SUPER_ADMIN_BOOTSTRAP_PASSWORD=change-me
