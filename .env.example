# ==============================================================================
# TALENTA UNIDA GONTOR — TEMPLATE KONFIGURASI LINGKUNGAN (.env.example)
# ==============================================================================
# Petunjuk:
# 1. Salin berkas ini menjadi `.env` di root direktori proyek:
#      cp .env.example .env
# 2. Sesuaikan nilai-nilai parameter di bawah ini sesuai kebutuhan lingkungan Anda.
# 3. JANGAN PERNAH menyertakan kredensial nyata atau rahasia ke dalam repositori Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI FRONTEND (Vite / React)
# ------------------------------------------------------------------------------

# Mode Lingkungan Aplikasi (VITE_APP_ENV)
# Pilihan nilai:
#   - DEPLOYMENT : Mode development/staging lokal. Di mode ini, halaman login (/masuk)
#                  menyediakan kartu login cepat (1-Klik) untuk mempermudah developer
#                  berpindah peran (Mahasiswa, Validator, Super Admin) tanpa perlu mengetik sandi.
#   - PRODUCTION : Mode produksi resmi kampus. Halaman login HANYA menampilkan formulir
#                  manual dengan email & password terenkripsi. Kartu demo disembunyikan.
VITE_APP_ENV=DEPLOYMENT

# Mode Mock / Data Tiruan (VITE_USE_MOCK)
# Pilihan nilai:
#   - false (Default) : Frontend terhubung langsung ke server Backend Elysia & Database MySQL nyata.
#   - true            : Frontend berjalan mandiri menggunakan data tiruan (in-memory & localStorage)
#                       tanpa memerlukan backend, database MySQL, atau RustFS storage.
VITE_USE_MOCK=false

# Prefix URL API (VITE_API_BASE_URL)
# Standar: /api/v1
# Endpoint dasar yang digunakan browser untuk memanggil REST API backend.
VITE_API_BASE_URL=/api/v1

# Alamat Proxy Server Backend (VITE_API_PROXY_TARGET)
# Standar: http://127.0.0.1:3001
# Alamat server backend lokal. Digunakan oleh Vite dev server untuk meneruskan permintaan
# rute `/api` dan `/health` ke backend Elysia tanpa terkendala CORS di browser.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# 1B. PENGATURAN RUNTIME SERVER & KONTAINER (Stage 6 / Produksi)
# ------------------------------------------------------------------------------
# Tag image GHCR untuk deployment Compose (commit SHA atau tag rilis immutable)
IMAGE_TAG=latest
# Port HTTP backend API internal container
PORT=3001
# Level log server (debug, info, warn, error)
LOG_LEVEL=info
# Batas maksimum unggah bukti prestasi (8 MB = 8388608 bytes)
UPLOAD_MAX_BYTES=8388608
# Zona waktu tampilan dan validasi kalender domain
TIMEZONE_DISPLAY=Asia/Jakarta


# ------------------------------------------------------------------------------
# 2. KEAMANAN & SESI APLIKASI BACKEND (Elysia / Bun)
# ------------------------------------------------------------------------------

# Domain Publik Resmi (PUBLIC_ORIGIN)
# Contoh lokal   : http://localhost:5173
# Contoh produksi: https://talenta.unida.gontor.ac.id
# Digunakan untuk verifikasi keamanan proteksi CSRF (Cross-Site Request Forgery).
# Permintaan mutasi (POST/PUT/PATCH/DELETE) dari origin lain akan otomatis ditolak.
PUBLIC_ORIGIN=http://localhost:5173

# Percaya Reverse Proxy (TRUST_PROXY)
# Pilihan nilai:
#   - true  : Gunakan jika server berada di balik reverse proxy seperti Cloudflare Tunnel,
#             Nginx, Traefik, atau Docker Proxy. Backend akan membaca header X-Forwarded-For
#             untuk mendapatkan alamat IP asli klien.
#   - false : Gunakan jika server diakses langsung tanpa proxy perantara.
TRUST_PROXY=false

# Kunci Enkripsi Sesi (SESSION_SECRET)
# Tipe: String acak aman (minimal 32 karakter).
# Digunakan oleh backend untuk menandatangani token sesi login mahasiswa dan staf.
# Generator rekomendasi: `openssl rand -base64 32`
SESSION_SECRET=change-with-a-very-long-random-secret-key-at-least-32-chars

# Kunci Pengaman Cookie (COOKIE_SECRET)
# Tipe: String acak aman (minimal 32 karakter).
# Digunakan untuk menandatangani cookie HTTP-only `talenta_session` agar tidak dapat dipalsukan.
COOKIE_SECRET=change-with-another-very-long-random-secret-key-at-least-32-chars


# ------------------------------------------------------------------------------
# 3. KONEKSI BASIS DATA (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Backend mendukung konfigurasi terpecah (DB_*) maupun URL tunggal (DATABASE_URL).

# Alamat Host Server MySQL (DB_HOST)
# Contoh lokal : 127.0.0.1 atau localhost
# Contoh server: mysql.internal
DB_HOST=127.0.0.1

# Port MySQL (DB_PORT)
# Standar MySQL: 3306
DB_PORT=3306

# Nama Pengguna Basis Data (DB_USER)
# Contoh: root atau user khusus seperti talenta_app
DB_USER=root

# Kata Sandi Pengguna Basis Data (DB_PASSWORD)
# Kosongkan jika MySQL lokal tanpa password, atau isi sesuai sandi MySQL Anda.
DB_PASSWORD=

# Nama Database (DB_NAME)
# Contoh lokal   : talenta_dev
# Contoh produksi: talenta
DB_NAME=talenta_dev

# Opsi Alternatif: URL Koneksi Tunggal (DATABASE_URL)
# Jika diisi, variabel ini akan digunakan langsung oleh Prisma ORM:
# DATABASE_URL=mysql://root:@127.0.0.1:3306/talenta_dev


# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE S3-COMPATIBLE (RustFS / MinIO)
# ------------------------------------------------------------------------------
# Digunakan untuk menyimpan dokumen bukti prestasi (sertifikat, piagam, SK juara)
# secara privat dan aman. Berkas diunduh melalui endpoint resmi terotorisasi (anti-IDOR).

# URL Endpoint S3 Storage (S3_ENDPOINT)
# Contoh lokal : http://localhost:9000 atau http://127.0.0.1:9000
# Contoh server: https://s3.internal.example.com (isi sesuai endpoint RustFS privat Anda)
S3_ENDPOINT=http://127.0.0.1:9000

# Region S3 (S3_REGION)
# Standar MinIO/RustFS: us-east-1
S3_REGION=us-east-1

# Nama Bucket Penyimpanan (S3_BUCKET)
# Contoh: talentadevtest atau talenta-private
S3_BUCKET=talentadevtest

# Kunci Akses (S3_ACCESS_KEY)
# Kredensial service account dari MinIO atau RustFS.
S3_ACCESS_KEY=change-with-your-s3-access-key

# Kunci Rahasia (S3_SECRET_KEY)
# Kredensial rahasia service account dari MinIO atau RustFS.
S3_SECRET_KEY=change-with-your-s3-secret-key

# Gaya Path Bucket S3 (S3_FORCE_PATH_STYLE)
# Pilihan nilai:
#   - true  : Wajib untuk MinIO / RustFS lokal (format URL: http://endpoint/bucket-name/file).
#   - false : Digunakan untuk AWS S3 standar (format URL: http://bucket-name.s3.amazonaws.com).
S3_FORCE_PATH_STYLE=true


# ------------------------------------------------------------------------------
# 5. LAYANAN PENGIRIMAN EMAIL (SMTP - Simple Mail Transfer Protocol)
# ------------------------------------------------------------------------------
# Digunakan untuk mengirimkan tautan pemulihan kata sandi (reset password) kepada mahasiswa/staf.
# Di lingkungan produksi, konfigurasi ini wajib diisi dengan benar.

# Alamat Server SMTP (SMTP_HOST)
# Contoh Gmail   : smtp.gmail.com
# Contoh internal: mail.unida.gontor.ac.id
SMTP_HOST=smtp.example.com

# Port Server SMTP (SMTP_PORT)
# Port 587 : Digunakan untuk koneksi terenkripsi STARTTLS (umum digunakan).
# Port 465 : Digunakan untuk koneksi terenkripsi SSL langsung.
SMTP_PORT=587

# Keamanan SSL Langsung (SMTP_SECURE)
# Pilihan nilai:
#   - false : Jika menggunakan port 587 (STARTTLS).
#   - true  : Jika menggunakan port 465 (SSL/TLS langsung).
SMTP_SECURE=false

# Nama Pengguna / Email Akun SMTP (SMTP_USER)
SMTP_USER=no-reply@unida.gontor.ac.id

# Kata Sandi Akun SMTP (SMTP_PASS)
# Gunakan "App Password" jika menggunakan layanan email seperti Gmail.
SMTP_PASS=change-with-smtp-password

# Nama & Alamat Pengirim (SMTP_FROM)
# Alamat yang akan terlihat sebagai pengirim di kotak masuk email pengguna.
SMTP_FROM="TALENTA UNIDA Gontor" <no-reply@unida.gontor.ac.id>


# ------------------------------------------------------------------------------
# 6. INISIALISASI SUPER ADMIN PERTAMA KALI (Seed Bootstrap)
# ------------------------------------------------------------------------------
# Akun administrator utama yang dibuat secara otomatis saat menjalankan seed basis data:
# `bun x prisma db seed` atau `bun backend/prisma/seed.ts`.
# Jangan gunakan kredensial bawaan ini di server produksi!

# Email Akun Super Admin Awal (SUPER_ADMIN_BOOTSTRAP_EMAIL)
SUPER_ADMIN_BOOTSTRAP_EMAIL=admin@unida.gontor.ac.id

# Kata Sandi Akun Super Admin Awal (SUPER_ADMIN_BOOTSTRAP_PASSWORD)
# Minimal 8 karakter, mengandung huruf besar, huruf kecil, angka, dan simbol.
# Wajib diisi secara acak dan kuat saat bootstrap produksi, lalu hapus/putar setelah bootstrap.
SUPER_ADMIN_BOOTSTRAP_PASSWORD=change-with-strong-bootstrap-password
