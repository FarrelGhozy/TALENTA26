# ==============================================================================
# UNIDA STUDENT CHAMPIONSHIP (USC) — TEMPLATE KONFIGURASI LINGKUNGAN (.env.example)
# ==============================================================================
# Petunjuk:
# 1. Pengembangan lokal (tanpa Docker): salin menjadi `.env` di root direktori proyek:
#      cp .env.example .env
# 2. Deployment PRODUCTION container (`infra/docker-compose.yaml`): salin dan set `.env`
#    di dalam folder `infra/` (`cp .env.example infra/.env && chmod 600 infra/.env`),
#    lalu jalankan `cd infra && docker compose pull && docker compose up -d`.
#    Catatan: `infra/docker-compose.yaml` otomatis menimpa `NODE_ENV=production`
#    dan `PORT=3001` di kontainer `api`.
# 3. Sesuaikan nilai-nilai parameter di bawah ini sesuai kebutuhan lingkungan Anda.
# 4. JANGAN PERNAH menyertakan kredensial nyata atau rahasia ke dalam repositori Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI FRONTEND (Vite / React — Build & Pengembangan Lokal)
# ------------------------------------------------------------------------------

# Mode Lingkungan Aplikasi (VITE_APP_ENV)
# Pilihan nilai:
#   - DEPLOYMENT : Mode development/staging lokal (kartu login cepat aktif di /masuk).
#   - PRODUCTION : Mode produksi resmi (hanya form manual; otomatis dikunci saat `bun run build`,
#                  sekaligus menjadi default bila kosong pada mode non-demo).
VITE_APP_ENV=DEPLOYMENT

# Mode Mock / Data Tiruan (VITE_USE_MOCK)
# Pilihan nilai:
#   - false (Default) : Frontend terhubung langsung ke server Backend Elysia & MySQL nyata.
#   - true            : Frontend berjalan mandiri menggunakan data tiruan (in-memory & localStorage).
# Catatan: `bun run build` (--mode production) selalu menimpa menjadi false;
#          `bun run build:demo` (--mode demo) selalu mengaktifkan mode mock.
VITE_USE_MOCK=false

# Prefix URL API (VITE_API_BASE_URL)
# Standar: /api/v1 (same-origin). Bila diawali `/`, Vite dev server mem-proxy `/api` & `/health`.
VITE_API_BASE_URL=/api/v1

# Alamat Proxy Server Backend (VITE_API_PROXY_TARGET)
# Standar: http://127.0.0.1:3001 (hanya dipakai Vite dev server lokal saat VITE_USE_MOCK=false)
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Base Path Non-Produksi / Demo (VITE_BASE_PATH)
# Default: / (dipakai saat `bun run dev` atau `bun run build:demo`, mis. /TALENTA26/ untuk GitHub Pages demo).
# Diabaikan sepenuhnya oleh `bun run build` (--mode production).
VITE_BASE_PATH=/

# Base Path Khusus Build Produksi (PROD_BASE_PATH)
# Default: / (override base path khusus `bun run build` --mode production).
# Pertahankan `/` untuk deployment domain root atau container Nginx produksi.
PROD_BASE_PATH=/


# ------------------------------------------------------------------------------
# 1B. PENGATURAN RUNTIME SERVER & KONTAINER (Production Compose / GHCR)
# ------------------------------------------------------------------------------

# Pemilik repositori GHCR untuk menarik image di `infra/docker-compose.yaml` (huruf kecil)
GHCR_OWNER=farrelghozy

# Host bind & port container pada server (`infra/docker-compose.yaml`):
# Default bind 127.0.0.1 (localhost) agar siap dibelokkan Cloudflare Tunnel tanpa mengekspos LAN/publik.
# Ubah *_BIND_HOST ke 0.0.0.0 hanya bila sengaja ingin diakses langsung dari antarmuka jaringan lain.
# Target host produksi:
#   - Frontend (`web` Nginx -> container port 80)   : http://localhost:3350
#   - Backend  (`api` Elysia -> container port 3001): http://localhost:3360
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3350
API_BIND_HOST=127.0.0.1
API_PORT=3360

# Tag image GHCR untuk deployment Compose:
#   - latest       : build terbaru dari branch `main` (default bila tidak diset)
#   - vX.Y.Z / tag : tag rilis spesifik (mis. v1.0.0 atau sha-abc1234)
IMAGE_TAG=latest

# Mode runtime server backend (`development` untuk lokal, `test` untuk pengujian;
# Docker Compose & Dockerfile produksi memaksa `production`)
NODE_ENV=development

# Port HTTP backend API untuk mode lokal non-Docker (`bun run dev:backend`, default: 3001).
# Di kontainer Docker Compose produksi, `api` selalu memakai port internal 3001 dan diekspos
# di host melalui API_PORT (default: 3360).
PORT=3001

# Level log terstruktur JSON server (`debug`, `info`, `warn`, `error`)
# Default di kode bila kosong: `info` pada production, `debug` pada non-production.
LOG_LEVEL=info

# Batas maksimum ukuran per berkas bukti prestasi dalam byte
# Default: 8388608 (8 MB). Rentang parser backend: 1024 (1 KB) s.d. 26214400 (25 MB).
# Catatan: Nginx edge membatasi upload bukti prestasi 26m (maks 3 berkas x 8 MB + multipart) & avatar 3m.
UPLOAD_MAX_BYTES=8388608

# Zona waktu IANA tampilan & validasi batas tanggal capaian prestasi agar tidak melampaui hari ini
TIMEZONE_DISPLAY=Asia/Jakarta


# ------------------------------------------------------------------------------
# 1C. PROTEKSI DDOS, KUOTA, & ANTI-BLOAT MYSQL / RUSTFS
# ------------------------------------------------------------------------------

# Batas maksimum koneksi pool MariaDB/MySQL dari backend (rentang valid: 2–100; default: 15, test: 5)
DB_POOL_LIMIT=15

# Kuota maksimum total objek bukti + avatar aktif per pengguna di storage (MB; rentang valid: 10–5000, default: 100)
USER_STORAGE_QUOTA_MB=100

# Batas maksimum jumlah revisi per pengajuan prestasi (rentang valid: 1–50, default: 5)
MAX_REVISIONS_PER_ACHIEVEMENT=5

# Batas maksimum pengajuan prestasi aktif per mahasiswa per periode akademik (rentang valid: 5–500, default: 30)
MAX_ACHIEVEMENTS_PER_PERIOD=30

# Batas maksimum sesi login aktif per akun secara bersamaan (rentang valid: 2–100, default: 10)
MAX_SESSIONS_PER_USER=10

# Retensi baris audit_events MySQL dalam hari (rentang valid: 0–36500, default: 365; 0 = simpan selamanya sesuai O-03)
AUDIT_RETENTION_DAYS=365

# Retensi berkas bukti tak aktif/ditolak/dibatalkan di RustFS dalam hari (rentang valid: 0–36500, default: 90; 0 = nonaktif)
STORAGE_RETENTION_INACTIVE_DAYS=90

# Interval pembersihan berkala otomatis di background dalam menit (rentang valid: 5–10080, default: 360 = 6 jam)
MAINTENANCE_INTERVAL_MINUTES=360

# Nonaktifkan penjadwal worker pemeliharaan latar belakang otomatis (MAINTENANCE_SCHEDULER_DISABLED)
# Pilihan nilai:
#   - false (Default) : Scheduler aktif di mode `development` & `production`.
#   - true            : Nonaktifkan scheduler otomatis (mis. bila pemeliharaan dijalankan via cron/CLI manual).
# Catatan: Pada `NODE_ENV=test`, scheduler selalu otomatis nonaktif.
MAINTENANCE_SCHEDULER_DISABLED=false

# Retensi arsip skrip `infra/scripts/backup-db.sh` & `infra/scripts/backup-storage.ts` dalam hari (default: 14; 0 = nonaktif)
BACKUP_RETENTION_DAYS=14


# ------------------------------------------------------------------------------
# 2. KEAMANAN & SESI APLIKASI BACKEND (Elysia / Bun)
# ------------------------------------------------------------------------------

# Domain Publik Resmi Frontend (PUBLIC_ORIGIN)
# Contoh lokal   : http://localhost:5173
# Contoh produksi: https://usc.unida.gontor.ac.id (WAJIB non-localhost di NODE_ENV=production)
# Digunakan untuk validasi CORS produksi, proteksi CSRF/Origin, dan tautan reset password.
PUBLIC_ORIGIN=http://localhost:5173

# Domain Publik Backend API Opsional (API_PUBLIC_ORIGIN)
# Kosongkan (`API_PUBLIC_ORIGIN=`) jika FE & BE berjalan di satu domain Cloudflare Tunnel (target localhost:3350).
# Isi jika FE dan BE memakai DUA subdomain terpisah di Cloudflare Tunnel, misal:
#   - PUBLIC_ORIGIN=https://app.domain.com        -> tunnel target http://localhost:3350
#   - API_PUBLIC_ORIGIN=https://api.domain.com    -> tunnel target http://localhost:3360
# Ketika diisi, container `web` otomatis menyuntikkan URL API ke frontend & header CSP tanpa rebuild image,
# dan backend menyesuaikan cookie sesi `HttpOnly; Secure; SameSite=None` lintas subdomain HTTPS.
API_PUBLIC_ORIGIN=

# Percaya Reverse Proxy (TRUST_PROXY)
# Pilihan nilai:
#   - true  : WAJIB true saat berjalan di balik Nginx + Cloudflare Tunnel (Docker Compose produksi)
#             agar `CF-Connecting-IP` / `X-Forwarded-For` terbaca aman untuk rate limiter & audit.
#   - false : Gunakan saat backend diakses langsung lokal tanpa reverse proxy.
TRUST_PROXY=false

# Kunci Enkripsi Sesi HMAC-SHA256 (SESSION_SECRET)
# Tipe: String acak aman (minimal 32 karakter). Produksi menolak prefix `dev-` dan `change-with-`.
# Generator rekomendasi: `openssl rand -base64 32`
SESSION_SECRET=change-with-a-very-long-random-secret-key-at-least-32-chars

# Kunci Pengaman Cookie (COOKIE_SECRET)
# Tipe: String acak aman (minimal 32 karakter). Produksi menolak prefix `dev-` dan `change-with-`.
COOKIE_SECRET=change-with-another-very-long-random-secret-key-at-least-32-chars


# ------------------------------------------------------------------------------
# 3. KONEKSI BASIS DATA (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Backend, Prisma (`prisma.config.ts`), & skrip backup mendukung konfigurasi terpecah (`DB_*`)
# maupun URL tunggal (`DATABASE_URL`). Bila `DB_HOST`, `DB_USER`, dan `DB_NAME` terisi, ketiganya
# diprioritaskan di atas `DATABASE_URL`. Di `NODE_ENV=production`, `prisma.config.ts` wajib mendapat salah satunya.

# Alamat Host Server MySQL (DB_HOST)
# Contoh lokal              : 127.0.0.1 atau localhost
# Contoh container Docker   : nama container/service MySQL di network eksternal `homelab-net` (mis. mysql)
# Contoh MySQL di host Linux: host.docker.internal
DB_HOST=127.0.0.1

# Port MySQL (DB_PORT)
DB_PORT=3306

# Nama Pengguna Basis Data (DB_USER)
DB_USER=root

# Kata Sandi Pengguna Basis Data (DB_PASSWORD)
DB_PASSWORD=

# Nama Database (DB_NAME)
# Contoh lokal   : talenta_dev
# Contoh produksi: talenta
DB_NAME=talenta_dev

# Opsi Alternatif: URL Koneksi Tunggal (DATABASE_URL)
# Dipakai oleh backend & Prisma bila DB_HOST/DB_USER/DB_NAME tidak diisi.
# DATABASE_URL=mysql://root:@127.0.0.1:3306/talenta_dev


# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE S3-COMPATIBLE (RustFS / MinIO) & FALLBACK LOKAL
# ------------------------------------------------------------------------------
# Digunakan untuk menyimpan dokumen bukti prestasi & avatar secara privat (anti-IDOR).
# Di NODE_ENV=production seluruh parameter S3 ini WAJIB valid (tanpa fallback disk lokal).
# Di NODE_ENV=development/test, bila nilai di bawah belum lengkap atau masih `change-with-*`,
# sistem otomatis memakai fallback penyimpanan lokal.

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=talentadevtest
S3_ACCESS_KEY=change-with-your-s3-access-key
S3_SECRET_KEY=change-with-your-s3-secret-key
# true wajib untuk MinIO / RustFS (path-style URL)
S3_FORCE_PATH_STYLE=true

# Direktori Fallback Penyimpanan Lokal (LOCAL_STORAGE_DIR)
# Hanya aktif di NODE_ENV=development/test saat S3 belum dikonfigurasi/masih placeholder.
# Default jika tidak diset: `<root-proyek>/.storage` (absolut terhadap proyek, aman dari CWD mana pun).
# LOCAL_STORAGE_DIR=.storage


# ------------------------------------------------------------------------------
# 5. LAYANAN PENGIRIMAN EMAIL (SMTP — Opsional saat startup, K-13 saat runtime)
# ------------------------------------------------------------------------------
# Digunakan untuk mengirimkan tautan pemulihan kata sandi (reset password).
# Opsional untuk menyalakan server: di NODE_ENV=production server tetap berjalan meski SMTP belum diset
# atau masih placeholder (`smtp.example.com` / `change-with-*`, hanya mencatat log peringatan startup).
# Namun jika `/api/v1/auth/forgot-password` dipanggil tanpa SMTP valid, sistem melempar error 503
# & mencatat log error tanpa membocorkan token. Di lokal tanpa SMTP valid, dikembalikan previewToken dev.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false untuk port 587 (STARTTLS), true untuk port 465 (SSL/TLS langsung)
SMTP_SECURE=false
SMTP_USER=no-reply@unida.gontor.ac.id
SMTP_PASS=change-with-smtp-password
# Bungkus seluruh nilai dengan tanda kutip agar kompatibel dengan Docker Compose .env parser.
SMTP_FROM="UNIDA Student Championship (USC) <no-reply@unida.gontor.ac.id>"


# ------------------------------------------------------------------------------
# 6. INISIALISASI SUPER ADMIN PERTAMA KALI (Seed Bootstrap)
# ------------------------------------------------------------------------------
# Menentukan email login (pengenal akun/username) dan kata sandi untuk Super Admin pertama kali.
# Pengenal login akun di halaman `/masuk` tetap memakai format EMAIL yang valid (maks 254 karakter).
#
# Cara menerapkan ke database sebelum login pertama kali:
#   - Lokal (tanpa Docker)        : jalankan `bun run db:seed` (atau `bun run db:seed:demo` untuk data simulasi)
#   - Production (Docker Compose) : dari folder `infra/`, jalankan:
#       `docker compose run --rm api bun backend/prisma/seed.ts`
#
# Setelah bootstrap selesai, buka `/masuk` (pilih tab "Login Manual" pada mode dev, atau langsung
# isi form di mode production) lalu masuk menggunakan email & kata sandi di bawah ini.
#
# Aturan & Keamanan:
#   - Seed hanya membuat akun baru bila belum ada `super_admin` di database (tidak menimpa akun existing).
#   - Panjang kata sandi wajib 8–128 karakter.
#   - Di NODE_ENV=production : kedua variabel WAJIB valid (menolak kosong serta prefix `change-with-` / `dev-`).
#     Setelah login pertama berhasil, hapus atau putar `SUPER_ADMIN_BOOTSTRAP_PASSWORD` di `infra/.env`.
#   - Di NODE_ENV=development/test : bila kosong atau masih placeholder `change-with-*`, seed otomatis
#     memakai default lokal `admin@unida.gontor.ac.id` / `AdminGontor2026!`.

SUPER_ADMIN_BOOTSTRAP_EMAIL=admin@unida.gontor.ac.id
SUPER_ADMIN_BOOTSTRAP_PASSWORD=change-with-strong-bootstrap-password


# ------------------------------------------------------------------------------
# 7. PENGUJIAN OTOMATIS & FLAG KHUSUS TESTING / DEBUGGING
# ------------------------------------------------------------------------------
# Parameter di bawah opsional untuk runner E2E (`./run-e2e.sh` / `bun run test:e2e`) dan
# pengujian unit/integrasi (`NODE_ENV=test`). Aman dibiarkan pada nilai bawaan.

# URL target frontend untuk suite Playwright E2E (default: http://localhost:5173)
E2E_BASE_URL=http://localhost:5173

# URL target backend API untuk suite Playwright E2E (default: http://localhost:3001)
E2E_API_URL=http://localhost:3001

# Mode headless browser Playwright E2E (`true` default = tanpa GUI; `false` = tampilkan jendela browser)
HEADLESS=true

# Khusus NODE_ENV=test: set `true` untuk mem-bypass InMemoryRateLimiter selama uji tertentu.
# Tidak berpengaruh pada mode `development` atau `production`.
RATE_LIMIT_DISABLED=false

# Khusus NODE_ENV=test: set `true` untuk mengaktifkan BoundedReadCache (TTL 30 detik) selama uji cache.
# Pada mode `development` dan `production`, cache baca selalu aktif secara bawaan.
READ_CACHE_ENABLED=false
