# contoh — copy ke FE sebagai .env saat init Vite
# Nilai kapital wajib: DEPLOYMENT | PRODUCTION
VITE_APP_ENV=DEPLOYMENT
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:3000/api

# Kombinasi resmi:
# demo     : DEPLOYMENT + true
# prod uji : PRODUCTION + true  (login form mock demo123)
# prod real: Tahap 2  PRODUCTION + false
