    "@aws-sdk/client-s3": "^3.1174.0",
    "@elysiajs/cors": "1.4.3",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "elysia": "1.4.32",
    "mariadb": "^3.5.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "prisma": "7.10.1",
    "typescript": "^7.0.2"
  }
}
