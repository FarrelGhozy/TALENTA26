// Prisma Schema untuk TALENTA — Tahap 3: Domain Mahasiswa & Pembinaan Kompetisi
// Menyesuaikan docs/10-model-data-mock.md, docs/05, docs/06, docs/07

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  mahasiswa
  validator
  super_admin
}

enum UserStatus {
  active
  suspended
  pending_verification
}

enum CompetitionFormat {
  individu
  beregu
}

enum CompetitionStatus {
  draft
  published
  archived
}

enum TeamStatus {
  mencari
  terbentuk
  terkunci_seleksi
  arsip
}

enum InviteStatus {
  diajukan
  diterima
  ditolak
  kedaluwarsa
  dibatalkan
}

enum TargetStatus {
  active
  archived
}

enum AchievementStatus {
  draft
  menunggu
  perlu_perbaikan
  disetujui
  ditolak
  dibatalkan
}

enum AchievementCategory {
  kompetisi
  konferensi
  olahraga
  seni
  nominasi
  lain
  seleksi_internal
}

enum AchievementLevel {
  lokal
  nasional
  internasional
}

enum AchievementResult {
  partisipasi
  finalis
  juara_3
  juara_2
  juara_1
  penghargaan_khusus
}

enum PointLedgerType {
  award
  reversal
}

enum ParticipationType {
  individu
  kelompok
}

enum TeamRecruitmentType {
  terbuka
  privat
}

enum JoinRequestStatus {
  menunggu
  disetujui
  ditolak
  dibatalkan
  kedaluwarsa
}

enum RegistrationStatus {
  buka
  tutup
}

model Institution {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  auditEvents           AuditEvent[]
  academicPeriods       AcademicPeriod[]
  competitions          Competition[]
  competitionCategories CompetitionCategory[]
  pointTemplates        PointTemplate[]
  competitionPointRules CompetitionPointRule[]
  achievements          Achievement[]
  pointRules            PointRule[]
  pointLedgers          PointLedger[]
  selections            InternalSelection[]

  @@map("institutions")
}

model AcademicPeriod {
  id            String    @id @default(cuid())
  institutionId String
  name          String
  year          Int
  semester      String    @default("ganjil")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  archivedAt    DateTime? @map("archived_at")
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution    Institution     @relation(fields: [institutionId], references: [id])
  competitions   Competition[]
  studentTargets StudentTarget[]
  achievements   Achievement[]
  pointLedgers   PointLedger[]

  @@index([institutionId, isActive])
  @@map("academic_periods")
}

model User {
  id            String     @id @default(cuid())
  institutionId String
  email         String     @unique
  fullName      String?    @map("full_name")
  passwordHash  String
  role          Role       @default(mahasiswa)
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  institution             Institution              @relation(fields: [institutionId], references: [id])
  studentProfile          StudentProfile?
  sessions                AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  auditEvents             AuditEvent[]
  studentTargets          StudentTarget[]
  createdTeams            Team[]                   @relation("TeamCreator")
  ledTeams                Team[]                   @relation("TeamLeader")
  teamMemberships         TeamMember[]
  sentInvites             TeamInvite[]             @relation("SentInvites")
  receivedInvites         TeamInvite[]             @relation("ReceivedInvites")
  joinRequests            TeamJoinRequest[]        @relation("JoinRequestApplicant")
  reviewedJoinRequests    TeamJoinRequest[]        @relation("JoinRequestReviewer")
  roadmapProgress         RoadmapProgress[]
  achievements            Achievement[]
  achievementParticipants AchievementParticipant[]
  uploadedEvidences       AchievementEvidence[]
  decidedAchievements     AchievementDecision[]
  pointLedgers            PointLedger[]
  participantSelections   InternalSelection[]      @relation("SelectionParticipant")
  confirmedSelections     InternalSelection[]      @relation("SelectionValidator")

  @@index([institutionId, role, status])
  @@map("users")
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  nim             String   @unique
  fullName        String
  studyProgram    String
  faculty         String
  enrollmentYear  Int?     @map("enrollment_year")
  avatarUrl       String?  @map("avatar_url") @db.Text
  avatarObjectKey String?  @map("avatar_object_key")
  phone           String?
  bio             String?  @db.Text
  skills          Json?
  interests       Json?
  availability    Json?
  rolesCapable    Json?
  experience      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nim])
  @@map("student_profiles")
}

model CompetitionCategory {
  id            String   @id @default(cuid())
  institutionId String   @map("institution_id")
  code          String
  name          String
  description   String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution              @relation(fields: [institutionId], references: [id])
  subCategories CompetitionSubCategory[]
  competitions  Competition[]
  achievements  Achievement[]

  @@unique([institutionId, code])
  @@map("competition_categories")
}

model CompetitionSubCategory {
  id                String   @id @default(cuid())
  categoryId        String   @map("category_id")
  code              String
  name              String
  description       String?  @db.Text
  defaultPointsNote String?  @map("default_points_note") @db.Text
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category              CompetitionCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  competitionPointRules CompetitionPointRule[]
  achievements          Achievement[]

  @@unique([categoryId, code])
  @@map("competition_sub_categories")
}

model PointTemplate {
  id            String   @id @default(cuid())
  institutionId String   @map("institution_id")
  name          String
  description   String?  @db.Text
  version       Int      @default(1)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution  Institution   @relation(fields: [institutionId], references: [id])
  rules        PointRule[]
  competitions Competition[]

  @@index([institutionId, version, isActive])
  @@map("point_templates")
}

model Competition {
  id                    String            @id @default(cuid())
  institutionId         String
  academicPeriodId      String?
  competitionCategoryId String?           @map("competition_category_id")
  pointTemplateId       String?           @map("point_template_id")
  slug                  String            @unique
  name                  String
  organizer             String
  category              String
  level                 String            @default("nasional")
  format                CompetitionFormat @default(beregu)
  minTeamMembers        Int               @default(1)
  maxTeamMembers        Int               @default(1)
  requiredRoles             Json?
  registrationDeadline      DateTime?
  competitionDate           DateTime?
  registrationStatus        RegistrationStatus @default(buka) @map("registration_status")
  internalSelectionDeadline DateTime?          @map("internal_selection_deadline")
  requireRoles              Boolean            @default(false) @map("require_roles")
  requireCrossStudyProgram  Boolean            @default(false) @map("require_cross_study_program")
  singleTeamPerCompetition  Boolean            @default(true) @map("single_team_per_competition")
  description               String             @db.Text
  requirements          Json?
  scheduleTimeline      Json?
  sourceUrl             String?           @map("source_url")
  sourceUpdatedAt       DateTime?         @map("source_updated_at")
  pointDescription      String?           @map("point_description") @db.Text
  status                CompetitionStatus @default(draft)
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  institution           Institution            @relation(fields: [institutionId], references: [id])
  academicPeriod        AcademicPeriod?        @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  competitionCategory   CompetitionCategory?   @relation(fields: [competitionCategoryId], references: [id], onDelete: SetNull)
  pointTemplate         PointTemplate?         @relation(fields: [pointTemplateId], references: [id], onDelete: SetNull)
  studentTargets        StudentTarget[]
  teams                 Team[]
  roadmaps              Roadmap[]
  consultantContacts    ConsultantContact[]
  achievements          Achievement[]
  selections            InternalSelection[]
  competitionPointRules CompetitionPointRule[]

  @@index([institutionId, status])
  @@index([academicPeriodId])
  @@index([slug])
  @@map("competitions")
}

model StudentTarget {
  id               String       @id @default(cuid())
  userId           String
  competitionId    String
  academicPeriodId String?      @map("academic_period_id")
  status           TargetStatus @default(active)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition    Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  academicPeriod AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([competitionId, status])
  @@index([academicPeriodId, status])
  @@map("student_targets")
}

model Team {
  id                  String              @id @default(cuid())
  competitionId       String
  name                String
  creatorId           String
  leaderId            String              @map("leader_id")
  description         String?             @db.Text
  recruitmentType     TeamRecruitmentType @default(terbuka) @map("recruitment_type")
  isRecruiting        Boolean             @default(true) @map("is_recruiting")
  neededRoles         Json?               @map("needed_roles")
  targetMaxMembers    Int?                @map("target_max_members")
  inviteCode          String?             @unique @map("invite_code")
  inviteCodeUpdatedAt DateTime?           @map("invite_code_updated_at")
  status              TeamStatus          @default(mencari)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  competition  Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  creator      User                @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  leader       User                @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members      TeamMember[]
  invites      TeamInvite[]
  joinRequests TeamJoinRequest[]
  selections   InternalSelection[]
  achievements Achievement[]

  @@index([competitionId, status])
  @@index([competitionId, recruitmentType, isRecruiting, status])
  @@index([creatorId])
  @@index([leaderId])
  @@map("teams")
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  userId     String
  roleInTeam String   @default("Anggota")
  status     String   @default("active")
  joinedAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId, status])
  @@index([userId, status])
  @@map("team_members")
}

model TeamInvite {
  id          String       @id @default(cuid())
  teamId      String
  senderId    String
  receiverId  String
  status      InviteStatus @default(diajukan)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender   User @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedInvites", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([receiverId, status])
  @@map("team_invites")
}

model TeamJoinRequest {
  id            String            @id @default(cuid())
  teamId        String            @map("team_id")
  userId        String            @map("user_id")
  preferredRole String?           @map("preferred_role")
  note          String?           @db.Text
  status        JoinRequestStatus @default(menunggu)
  reviewedById  String?           @map("reviewed_by_id")
  reviewedAt    DateTime?         @map("reviewed_at")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User  @relation("JoinRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([userId, status])
  @@map("team_join_requests")
}

model Roadmap {
  id            String            @id @default(cuid())
  competitionId String
  version       Int               @default(1)
  status        CompetitionStatus @default(published)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phases      RoadmapPhase[]

  @@index([competitionId, status])
  @@map("roadmaps")
}

model RoadmapPhase {
  id          String   @id @default(cuid())
  roadmapId   String
  orderIndex  Int
  title       String
  description String?  @db.Text
  targetDays  Int?
  createdAt   DateTime @default(now())

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks   RoadmapTask[]

  @@index([roadmapId, orderIndex])
  @@map("roadmap_phases")
}

model RoadmapTask {
  id            String   @id @default(cuid())
  phaseId       String
  orderIndex    Int
  title         String
  description   String?  @db.Text
  isRequired    Boolean  @default(true)
  resourceUrl   String?
  resourceTitle String?
  createdAt     DateTime @default(now())

  phase    RoadmapPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  progress RoadmapProgress[]

  @@index([phaseId, orderIndex])
  @@map("roadmap_tasks")
}

model RoadmapProgress {
  id          String    @id @default(cuid())
  userId      String
  taskId      String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task RoadmapTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@map("roadmap_progress")
}

model ConsultantContact {
  id             String            @id @default(cuid())
  competitionId  String
  name           String
  field          String
  whatsappNumber String
  capacityNote   String?
  isApproved     Boolean           @default(true)
  status         CompetitionStatus @default(published)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, isApproved, status])
  @@map("consultant_contacts")
}

model InternalSelection {
  id                String    @id @default(cuid())
  institutionId     String
  competitionId     String
  teamId            String?
  userId            String?   @map("user_id")
  stage             String
  result            String    @default("menunggu")
  organizerVerified Boolean   @default(false)
  notes             String?   @db.Text
  confirmedAt       DateTime? @map("confirmed_at")
  validatorId       String?   @map("validator_id")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant User?       @relation("SelectionParticipant", fields: [userId], references: [id], onDelete: Cascade)
  validator   User?       @relation("SelectionValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  @@unique([competitionId, teamId, stage])
  @@unique([competitionId, userId, stage])
  @@index([institutionId, result])
  @@map("internal_selections")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?   @db.Text
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id            String   @id @default(cuid())
  institutionId String
  actorId       String?
  action        String
  targetType    String
  targetId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([actorId, action])
  @@map("audit_events")
}

model Achievement {
  id                      String              @id @default(cuid())
  institutionId           String
  userId                  String
  academicPeriodId        String?
  competitionId           String?
  competitionCategoryId   String?             @map("competition_category_id")
  subCategoryId           String?             @map("sub_category_id")
  subCompetitionName      String?             @map("sub_competition_name")
  teamId                  String?             @map("team_id")
  participationType       ParticipationType   @default(individu) @map("participation_type")
  potentialDuplicateOfId  String?             @map("potential_duplicate_of_id")
  name                    String
  organizer               String
  category                AchievementCategory @default(kompetisi)
  level                   AchievementLevel    @default(nasional)
  result                  AchievementResult   @default(juara_1)
  eventDate               DateTime
  description             String?             @db.Text
  isFromInternalSelection Boolean             @default(false)
  status                  AchievementStatus   @default(menunggu)
  version                 Int                 @default(1)
  reviewNote              String?             @db.Text
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  institution         Institution              @relation(fields: [institutionId], references: [id])
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicPeriod      AcademicPeriod?          @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  competition         Competition?             @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  competitionCategory CompetitionCategory?     @relation(fields: [competitionCategoryId], references: [id], onDelete: SetNull)
  subCategory         CompetitionSubCategory?  @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  team                Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  participants        AchievementParticipant[]
  evidences           AchievementEvidence[]
  revisions           AchievementRevision[]
  decisions           AchievementDecision[]
  pointLedgers        PointLedger[]

  @@index([institutionId, status])
  @@index([userId, status])
  @@index([academicPeriodId])
  @@index([competitionId])
  @@index([teamId])
  @@map("achievements")
}

model AchievementParticipant {
  id            String   @id @default(cuid())
  achievementId String   @map("achievement_id")
  userId        String   @map("user_id")
  roleInTeam    String?  @map("role_in_team")
  isSubmitter   Boolean  @default(false) @map("is_submitter")
  createdAt     DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([achievementId, userId])
  @@index([userId])
  @@map("achievement_participants")
}

model AchievementEvidence {
  id                     String   @id @default(cuid())
  achievementId          String
  uploaderId             String
  objectKey              String   @unique
  fileName               String
  fileSize               Int
  mimeType               String
  isActive               Boolean  @default(true) @map("is_active")
  supersededByRevisionId String?  @map("superseded_by_revision_id")
  uploadedAt             DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  uploader    User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([achievementId, isActive])
  @@index([uploaderId])
  @@map("achievement_evidences")
}

model AchievementRevision {
  id            String   @id @default(cuid())
  achievementId String
  versionNumber Int
  snapshotJson  Json
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([achievementId, versionNumber])
  @@map("achievement_revisions")
}

model AchievementDecision {
  id               String            @id @default(cuid())
  achievementId    String
  decidedById      String
  action           String
  previousStatus   AchievementStatus
  newStatus        AchievementStatus
  reason           String?           @db.Text
  calculatedPoints Int?              @map("calculated_points")
  awardedPoints    Int?              @map("awarded_points")
  pointSource      String?           @map("point_source")
  overrideReason   String?           @map("override_reason") @db.Text
  version          Int
  createdAt        DateTime          @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  decidedBy   User        @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([achievementId])
  @@index([decidedById])
  @@map("achievement_decisions")
}

model PointRule {
  id              String            @id @default(cuid())
  institutionId   String
  pointTemplateId String?           @map("point_template_id")
  version         Int               @default(1)
  level           AchievementLevel
  result          AchievementResult
  points          Int
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  institution   Institution    @relation(fields: [institutionId], references: [id])
  pointTemplate PointTemplate? @relation(fields: [pointTemplateId], references: [id], onDelete: SetNull)

  @@unique([institutionId, version, level, result])
  @@index([institutionId, version, isActive])
  @@map("point_rules")
}

model CompetitionPointRule {
  id            String            @id @default(cuid())
  institutionId String            @map("institution_id")
  competitionId String?           @map("competition_id")
  subCategoryId String?           @map("sub_category_id")
  level         AchievementLevel
  result        AchievementResult
  points        Int
  description   String?           @db.Text
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  institution Institution             @relation(fields: [institutionId], references: [id])
  competition Competition?            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  subCategory CompetitionSubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@index([institutionId, competitionId, subCategoryId, isActive])
  @@map("competition_point_rules")
}

model PointLedger {
  id                 String          @id @default(cuid())
  institutionId      String
  userId             String
  achievementId      String
  academicPeriodId   String?
  ruleVersion        Int             @default(1)
  points             Int
  type               PointLedgerType @default(award)
  pointSource        String          @default("template") @map("point_source")
  calculatedPoints   Int?            @map("calculated_points")
  overrideReason     String?         @map("override_reason") @db.Text
  idempotencyKey     String?         @unique @map("idempotency_key")
  reversedByLedgerId String?         @map("reversed_by_ledger_id")
  reason             String?         @db.Text
  createdAt          DateTime        @default(now())

  institution    Institution     @relation(fields: [institutionId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement    Achievement     @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  academicPeriod AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)

  @@index([institutionId, userId])
  @@index([achievementId])
  @@index([academicPeriodId])
  @@map("point_ledgers")
}
