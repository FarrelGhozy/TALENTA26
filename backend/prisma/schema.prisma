// Prisma Schema untuk TALENTA — Tahap 3: Domain Mahasiswa & Pembinaan Kompetisi
// Menyesuaikan docs/10-model-data-mock.md, docs/05, docs/06, docs/07

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  mahasiswa
  validator
  super_admin
}

enum UserStatus {
  active
  suspended
  pending_verification
}

enum CompetitionFormat {
  individu
  beregu
}

enum CompetitionStatus {
  draft
  published
  archived
}

enum TeamStatus {
  mencari
  terbentuk
  terkunci_seleksi
  arsip
}

enum InviteStatus {
  diajukan
  diterima
  ditolak
  kedaluwarsa
  dibatalkan
}

enum TargetStatus {
  active
  archived
}

model Institution {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  auditEvents     AuditEvent[]
  academicPeriods AcademicPeriod[]
  competitions    Competition[]

  @@map("institutions")
}

model AcademicPeriod {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  year          Int
  semester      String   @default("ganjil")
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution  Institution   @relation(fields: [institutionId], references: [id])
  competitions Competition[]

  @@index([institutionId, isActive])
  @@map("academic_periods")
}

model User {
  id            String     @id @default(cuid())
  institutionId String
  email         String     @unique
  passwordHash  String
  role          Role       @default(mahasiswa)
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  institution         Institution          @relation(fields: [institutionId], references: [id])
  studentProfile      StudentProfile?
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  studentTargets      StudentTarget[]
  createdTeams        Team[]               @relation("TeamCreator")
  teamMemberships     TeamMember[]
  sentInvites         TeamInvite[]         @relation("SentInvites")
  receivedInvites     TeamInvite[]         @relation("ReceivedInvites")
  roadmapProgress     RoadmapProgress[]

  @@index([institutionId, role, status])
  @@map("users")
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  nim          String   @unique
  fullName     String
  studyProgram String
  faculty      String
  phone        String?
  bio          String?  @db.Text
  skills       Json?
  interests    Json?
  availability Json?
  rolesCapable Json?
  experience   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nim])
  @@map("student_profiles")
}

model Competition {
  id                   String            @id @default(cuid())
  institutionId        String
  academicPeriodId     String?
  slug                 String            @unique
  name                 String
  organizer            String
  category             String
  level                String            @default("nasional")
  format               CompetitionFormat @default(beregu)
  minTeamMembers       Int               @default(1)
  maxTeamMembers       Int               @default(1)
  requiredRoles        Json?
  registrationDeadline DateTime?
  competitionDate      DateTime?
  description          String            @db.Text
  requirements         Json?
  scheduleTimeline     Json?
  status               CompetitionStatus @default(draft)
  version              Int               @default(1)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  institution        Institution         @relation(fields: [institutionId], references: [id])
  academicPeriod     AcademicPeriod?     @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  studentTargets     StudentTarget[]
  teams              Team[]
  roadmaps           Roadmap[]
  consultantContacts ConsultantContact[]

  @@index([institutionId, status])
  @@index([academicPeriodId])
  @@index([slug])
  @@map("competitions")
}

model StudentTarget {
  id            String       @id @default(cuid())
  userId        String
  competitionId String
  status        TargetStatus @default(active)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([competitionId, status])
  @@map("student_targets")
}

model Team {
  id            String     @id @default(cuid())
  competitionId String
  name          String
  creatorId     String
  status        TeamStatus @default(mencari)
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  creator     User         @relation("TeamCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members     TeamMember[]
  invites     TeamInvite[]

  @@index([competitionId, status])
  @@index([creatorId])
  @@map("teams")
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  userId     String
  roleInTeam String   @default("Anggota")
  status     String   @default("active")
  joinedAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId, status])
  @@index([userId, status])
  @@map("team_members")
}

model TeamInvite {
  id          String       @id @default(cuid())
  teamId      String
  senderId    String
  receiverId  String
  status      InviteStatus @default(diajukan)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender   User @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedInvites", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([receiverId, status])
  @@map("team_invites")
}

model Roadmap {
  id            String            @id @default(cuid())
  competitionId String
  version       Int               @default(1)
  status        CompetitionStatus @default(published)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phases      RoadmapPhase[]

  @@index([competitionId, status])
  @@map("roadmaps")
}

model RoadmapPhase {
  id          String   @id @default(cuid())
  roadmapId   String
  orderIndex  Int
  title       String
  description String?  @db.Text
  targetDays  Int?
  createdAt   DateTime @default(now())

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks   RoadmapTask[]

  @@index([roadmapId, orderIndex])
  @@map("roadmap_phases")
}

model RoadmapTask {
  id            String   @id @default(cuid())
  phaseId       String
  orderIndex    Int
  title         String
  description   String?  @db.Text
  isRequired    Boolean  @default(true)
  resourceUrl   String?
  resourceTitle String?
  createdAt     DateTime @default(now())

  phase    RoadmapPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  progress RoadmapProgress[]

  @@index([phaseId, orderIndex])
  @@map("roadmap_tasks")
}

model RoadmapProgress {
  id          String    @id @default(cuid())
  userId      String
  taskId      String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task RoadmapTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@map("roadmap_progress")
}

model ConsultantContact {
  id             String            @id @default(cuid())
  competitionId  String
  name           String
  field          String
  whatsappNumber String
  capacityNote   String?
  isApproved     Boolean           @default(true)
  status         CompetitionStatus @default(published)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, isApproved, status])
  @@map("consultant_contacts")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?   @db.Text
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id            String   @id @default(cuid())
  institutionId String
  actorId       String?
  action        String
  targetType    String
  targetId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([actorId, action])
  @@map("audit_events")
}
